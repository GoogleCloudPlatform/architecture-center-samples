# Google Cloud Project & Runtime Settings
PROJECT_ID=my-project-id
REGION=us-central1
SERVICE_ACCOUNT_EMAIL=my-service-account@my-project-id.iam.gserviceaccount.com
SERVICE_ACCOUNT_NAME=my-service-account
SERVICE_NAME=mcp-toolbox-ebs

# Artifact Registry Settings (Customer Project Build & Publish)
# When BUILD_AR_IMAGE=true (default), deploy.sh creates AR_REPO_NAME in your GCP project,
# builds the pre-configured Oracle EBS MCP Toolbox image (Dockerfile + 21 tools.yaml),
# and pushes it to ${REGION}-docker.pkg.dev/${PROJECT_ID}/${AR_REPO_NAME}/mcp-toolbox-ebs:latest
BUILD_AR_IMAGE=true
AR_REPO_NAME=ebs-mcp-repo
IMAGE_URL=us-central1-docker.pkg.dev/database-toolbox/toolbox/toolbox:latest

# VPC Direct Egress Settings (Private connectivity to Oracle EBS Database on TCP 1521)
VPC_NAME=my-vpc-network
SUBNET_NAME=my-subnet-us-central1

# Oracle E-Business Suite Database Connection (Stored in Google Cloud Secret Manager)
EBS_DB_CONNECTION_STRING=apps.example.com:1521/EBSDB
EBS_DB_USER=apps_ai
EBS_DB_PASSWORD=REPLACE_WITH_APPS_AI_PASSWORD
SECRET_NAME=mcp-toolbox-ebs-secret
