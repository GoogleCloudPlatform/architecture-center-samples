# Database credentials for the {{SYSTEM_UPPER}} Toolbox (read by scripts/deploy_mcp_server.sh).
#
# Generated next to {{SYSTEM}}/.env by: ./scripts/deploy_mcp_server.sh --system {{SYSTEM}} --init-env
# as {{SYSTEM}}/.env.database (mode 600, git-ignored). Fill in the values; the deploy script copies
# them into Secret Manager over stdin (never on a command line or on screen) and the Toolbox
# reads them from there. Do not commit this file.
#
# The local Toolbox scripts (scripts/toolbox_*.sh) and `eval "$(./scripts/env_export.sh --system {{SYSTEM}})"`
# read this file too, so one file serves both the deploy and local runs.
#
# Lookup order for each variable: process environment, then this file, then a hidden prompt.
# Values are taken literally: one pair of surrounding double quotes is removed, nothing else
# (no escapes, no ${} expansion), so a password may contain $, # or spaces.

# Go-ora connection string: host:port/service_name
DB_CONNECTION_STRING=""
DB_USER=""
DB_PASSWORD=""

# JD Edwards only: schema names when your database does not use PRODDTA/PRODCTL (for example
# PS920DTA/PS920CTL or TESTDTA/TESTCTL). Uncomment both with real values; never leave them empty.
# JDE_DATA_SCHEMA="PRODDTA"
# JDE_CTL_SCHEMA="PRODCTL"
