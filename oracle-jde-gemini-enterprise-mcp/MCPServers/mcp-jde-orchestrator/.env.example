# Google Cloud Project & Runtime Settings
PROJECT_ID=my-project-id
REGION=us-central1
SERVICE_ACCOUNT_EMAIL=my-service-account@my-project-id.iam.gserviceaccount.com
SERVICE_ACCOUNT_NAME=my-service-account
SERVICE_NAME=mcp-jde-orchestrator

# Artifact Registry Settings (Customer Project Build & Publish)
# When BUILD_AR_IMAGE=true (default), deploy.sh creates AR_REPO_NAME in your GCP project,
# builds the Hybrid JDE Orchestrator v3 + Oracle 19c SQL MCP image (Dockerfile + server.py),
# and pushes it to ${REGION}-docker.pkg.dev/${PROJECT_ID}/${AR_REPO_NAME}/mcp-jde-orchestrator:latest
BUILD_AR_IMAGE=true
AR_REPO_NAME=jde-mcp-repo

# VPC Direct Egress Settings (Private connectivity to JDE AIS :7077 and Oracle 19c JDEORCL :1521)
VPC_NAME=oracle-jde-toolkit-network
SUBNET_NAME=oracle-jde-toolkit-subnet-01

# Oracle JD Edwards EnterpriseOne 9.2 AIS / Orchestrator v3 & Database Connection (Stored in Secret Manager)
JDE_AIS_BASE_URL=http://10.118.0.43:7077
JDE_ENVIRONMENT=JPD920
JDE_ROLE=MFG_MGR
JDE_USERNAME=NGONZAL
JDE_PASSWORD=REPLACE_WITH_JDE_AIS_PASSWORD
JDE_DB_DSN=10.118.0.41:1521/jdeorcl
JDE_DB_USER=JDE_AI
JDE_DB_PASSWORD=REPLACE_WITH_JDE_DB_PASSWORD
SECRET_NAME=mcp-jde-orchestrator-secret
