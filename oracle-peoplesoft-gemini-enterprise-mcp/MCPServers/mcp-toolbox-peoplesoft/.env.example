# Google Cloud Project & Runtime Settings
PROJECT_ID=my-project-id
REGION=us-central1
SERVICE_ACCOUNT_EMAIL=my-service-account@my-project-id.iam.gserviceaccount.com
SERVICE_ACCOUNT_NAME=my-service-account
SERVICE_NAME=mcp-toolbox-peoplesoft

# Artifact Registry Settings (Customer Project Build & Publish)
# When BUILD_AR_IMAGE=true (default), deploy.sh creates AR_REPO_NAME in your GCP project,
# builds the pre-configured Oracle PeopleSoft MCP Toolbox image (Dockerfile + 20 tools.yaml),
# and pushes it to ${REGION}-docker.pkg.dev/${PROJECT_ID}/${AR_REPO_NAME}/mcp-toolbox-peoplesoft:latest
BUILD_AR_IMAGE=true
AR_REPO_NAME=peoplesoft-mcp-repo
IMAGE_URL=us-central1-docker.pkg.dev/database-toolbox/toolbox/toolbox:latest

# VPC Direct Egress Settings (Private connectivity to Oracle PeopleSoft 9.2 Database on TCP 1521)
VPC_NAME=my-vpc-network
SUBNET_NAME=my-subnet-us-central1

# Oracle PeopleSoft 9.2 Database Connection (Stored in Google Cloud Secret Manager)
PSFT_DB_CONNECTION_STRING=psft-db.example.com:1521/EP92U055
PSFT_DB_USER=PSFT_AI
PSFT_DB_PASSWORD=REPLACE_WITH_PSFT_AI_PASSWORD
SECRET_NAME=mcp-toolbox-peoplesoft-secret
