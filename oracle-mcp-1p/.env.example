# Environment template for scripts/deploy_mcp_server.sh (one file per target system).
#
# Do not edit and use this file directly. Generate a system's env file with:
#   ./scripts/deploy_mcp_server.sh --system {ebs|peoplesoft|jde} --init-env
# which copies this template to {{SYSTEM}}/.env and replaces the {{...}} placeholders:
#   {{SYSTEM}}        ebs | peoplesoft | jde         (also the <system>/ directory)
#   {{SYSTEM_SHORT}}  ebs | ps | jde                 (service and secret name suffix)
#   {{SYSTEM_UPPER}}  EBS | PEOPLESOFT | JDE         (display name)
#   {{VARIANT_SUFFIX}} "" or -<name> when --variant <name> is given (a second deployment of the same system)
# Blank values are detected by the deploy script, which proposes a value or explains how to
# set it (you can also type your own). Database credentials are NOT stored here: the script
# prompts for them and keeps them in Secret Manager. Never commit {{SYSTEM}}/.env files.

# --- Vertex AI configuration (default) ---
GOOGLE_GENAI_USE_VERTEXAI="true"
GOOGLE_CLOUD_PROJECT=""
GOOGLE_CLOUD_PROJECT_NUMBER=""
# Model location (may be "global"); the Cloud Run region is GOOGLE_CLOUD_REGION below.
GOOGLE_CLOUD_LOCATION="global"

# Alternatively, for the Gemini API via Google AI Studio, comment out the three
# GOOGLE_GENAI_USE_VERTEXAI / GOOGLE_CLOUD_PROJECT / GOOGLE_CLOUD_LOCATION lines and set:
# GEMINI_API_KEY=""

# --- Infrastructure ({{SYSTEM_UPPER}} Toolbox on Cloud Run) ---
GOOGLE_CLOUD_REGION=""
# Runtime service account, e.g. <name>@<project>.iam.gserviceaccount.com. When blank the deploy
# script proposes {{SYSTEM_SHORT}}-service-account@<project>... and offers to create it.
GOOGLE_CLOUD_SERVICE_ACCOUNT=""
# VPC network and subnet (Direct VPC egress) that can reach the {{SYSTEM_UPPER}} database
GOOGLE_CLOUD_NETWORK=""
GOOGLE_CLOUD_SUBNET=""
# OPTIONAL: a PSC network attachment for private VPC egress.
GOOGLE_CLOUD_NETWORK_ATTACHMENT=""
MCP_TOOLBOX_SERVICE_NAME="mcp-toolbox-{{SYSTEM_SHORT}}{{VARIANT_SUFFIX}}"
# [Legacy] Secret Manager secret holding tools.yaml
MCP_TOOLBOX_SECRET_NAME="mcp-toolbox-{{SYSTEM_SHORT}}{{VARIANT_SUFFIX}}-secrets"
# GCS bucket holding tools.yaml (at <service-name>/tools.yaml)
MCP_TOOLBOX_BUCKET=""
MCP_TOOLBOX_IMAGE="us-central1-docker.pkg.dev/database-toolbox/toolbox/toolbox:latest"
# Tools file to deploy, e.g. {{SYSTEM}}/tools.yaml; when blank the deploy script lists {{SYSTEM}}/tools*.yaml
MCP_TOOLBOX_TOOLS_FILE=""
# Set by the deploy script after deploying; callers use this URL
MCP_SERVER_SQL_URL=""

# --- User identity ---
# "agent" (default): the calling agent verifies the user's Google access token and sets each tool's user_id.
# The Toolbox it calls (MCP_SERVER_SQL_URL) must be deployed behind a private Cloud Run service.
# "toolbox": legacy; Toolbox's `google` authService validates the token.
TOOLBOX_USER_AUTH="agent"
# Target system name
AGENT_SYSTEM_NAME="{{SYSTEM_UPPER}}"
# OAuth client ID for the google-auth authService (tools.yaml uses ${GOOGLE_CLIENT_ID})
GOOGLE_CLIENT_ID=""
GOOGLE_CLOUD_AUTH_ID=""

# --- Gemini Enterprise publishing (optional) ---
# Redirect URI of the OAuth client; blank = https://vertexaisearch.cloud.google.com/oauth-redirect
OAUTH_REDIRECT_URI=""
# Full app resource name: projects/<number>/locations/global/collections/default_collection/engines/<id>
GEMINI_ENTERPRISE_APP_ID=""

# Optional: restrict to these email domains (comma separated). Empty allows any verified account.
ALLOWED_EMAIL_DOMAINS=""
# Local runs only (ignored unless LOCAL_DEV=true): act as this user instead of verifying a token.
LOCAL_DEV=""
LOCAL_DEV_USER_EMAIL=""
